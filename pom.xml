<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-mesh-pipelines-kvstore</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>hitorro-mesh-pipelines-kvstore</name>
    <description>
        Real RocksDB-backed KvStore sink + source for hitorro-mesh-pipelines.
        Registered via ServiceLoader (SinkAdapter, SourceAdapter) — dropping
        this jar on the classpath upgrades the Phase-1 TSV stub to a real,
        queryable KV store. Physical files land under
        ${hitorro.pipelines.home}/kv/&lt;name&gt;/.

        Depends on rocksdbjni directly (bypasses hitorro-kvstore for a
        minimal footprint). Users who want the full hitorro-kvstore API
        (typed stores, batch, WAL replication) can wrap our sink or add
        it as a separate dep.
    </description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-pipelines</artifactId>
            <version>3.0.1</version>
        </dependency>
        <!-- The actual KvStoreSink + RocksDbSharedRegistry live in hitorro-kvstore
             so non-mesh callers can use them directly. This module is glue only.

             Exclude slf4j-reload4j (transitive via hitorro-util → hadoop-common):
             conflicts with Spring Boot's logback and prevents driver startup. -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-kvstore</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.reload4j</groupId>
                    <artifactId>reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.rocksdb</groupId>
            <artifactId>rocksdbjni</artifactId>
            <version>9.7.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
    </distributionManagement>
</project>
